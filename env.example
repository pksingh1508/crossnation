# Site Configuration
NEXT_PUBLIC_SITE_URL=https://eucareerserwis.com

# Next-intl Configuration
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_LOCALES=en,es,pl,fr,it,de

# SEO & Analytics Configuration
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-site-verification-code

# Social Media Configuration
NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id
NEXT_PUBLIC_TWITTER_SITE=@eucareerserwis

# CMS Configuration (Supabase, read-only). Server-side only: no NEXT_PUBLIC_ prefix.
# Use the publishable key, never the secret / service_role key.
CMS_SUPABASE_URL=https://yjcepgcqaxmcsowruayi.supabase.co
CMS_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Optional: lets the CMS refresh the site right after an edit (POST /api/revalidate).
# Without it, new content shows within 5 minutes.
CMS_REVALIDATE_SECRET=generate-with-openssl-rand-base64-32

# Performance Monitoring
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
